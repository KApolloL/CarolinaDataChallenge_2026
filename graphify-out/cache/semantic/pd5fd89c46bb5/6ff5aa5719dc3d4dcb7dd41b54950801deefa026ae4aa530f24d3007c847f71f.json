{"nodes": [{"id": "src__analysis_body", "label": "Analysis Body (shared Quarto child)", "file_type": "document", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src__analysis_body_noaa_storm_events", "label": "NOAA Storm Events Database", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official record of storm outcomes; defines the targets. Damage in nominal dollars; many forecast-zone records lack coordinates."}, {"id": "src__analysis_body_event_level_table", "label": "Event-level table (one row per EVENT_ID)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Details table collapsed with max() not sum, fatalities and locations aggregated separately, because naive joins inflate deaths, injuries and damage."}, {"id": "src__analysis_body_region_assignment", "label": "NC region assignment (county/forecast-zone matching)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zones matched by name since CZ_FIPS is a zone number; unmatched records never defaulted to a region."}, {"id": "src__analysis_body_usgs_nhd", "label": "USGS NHD High Resolution and WBD", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flood harm concentrates near moving water; gives stream distance, counts, density, HUC12."}, {"id": "src__analysis_body_terrain_3dep", "label": "3DEP-derived terrain (elevation, slope, roughness)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steep rugged terrain speeds runoff and isolates communities; 62 m cells coarser than native 3DEP."}, {"id": "src__analysis_body_ncdot_crossings", "label": "NCDOT bridges, structures and culverts", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Road crossings of streams are where floods damage infrastructure and block access; inventory may be incomplete."}, {"id": "src__analysis_body_nlcd_imperviousness", "label": "USGS Annual NLCD fractional imperviousness", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pavement sheds water fast; year-matched 2016-2023, later events use 2023."}, {"id": "src__analysis_body_ssurgo_soils", "label": "USDA SSURGO soils", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slow-draining hydrologic groups C/D produce more runoff; only tabular summary, no map-unit geometry so not assigned to events (would invent values)."}, {"id": "src__analysis_body_gridmet_rainfall", "label": "gridMET daily precipitation", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets model separate dangerous places from places that simply got most rain; 4 km daily smooths short bursts; explanatory not forecast."}, {"id": "src__analysis_body_hydrology_hand", "label": "DEM hydrology: HAND and drainage area (WhiteboxTools)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equal stream distance is not equal exposure; low height above stream on large rivers floods more. DEM stops at state line so basins undercounted."}, {"id": "src__analysis_body_cdc_svi", "label": "CDC/ATSDR Social Vulnerability Index (tract)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "County averages hide hardest-hit neighborhoods; percentiles are ranks within a release so not comparable across years."}, {"id": "src__analysis_body_spatial_features", "label": "Spatial features measured around each event", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Point and buffer measures in EPSG:32119; rasters never resampled, points projected to raster CRS."}, {"id": "src__analysis_body_coordinate_cleaning", "label": "Common CRS and geometry cleaning (st_zm, st_make_valid, st_transform)", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NHD XYZM geometry cannot be processed by GEOS, so Z/M dropped and geometry repaired before spatial operations."}, {"id": "src__analysis_body_spatial_cache", "label": "Cached spatial features", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache reused only when every setting and input is unchanged; refresh_derived_data forces rebuild."}, {"id": "src__analysis_body_targets", "label": "High-consequence and high-human-impact targets", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deaths >= threshold OR damage above quantile of positive damage in training years; threshold computed on training split to avoid leakage."}, {"id": "src__analysis_body_leakage_rules", "label": "Leakage rules for modeling", "file_type": "rationale", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never use outcome columns as predictors; split by time; group CV by episode_id; leave spatial NAs missing, not zero."}, {"id": "src__analysis_body_chronological_split", "label": "Chronological train/validation/test split", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-based split to avoid leakage."}, {"id": "src__analysis_body_feature_dictionary", "label": "Feature dictionary", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documents role, units, source, leakage note of each column."}, {"id": "src__analysis_body_ml_ready_export", "label": "ML-ready data export", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export guarded: skipped if an enabled feature group is entirely missing, so degraded data never overwrites handoff files."}, {"id": "src__analysis_body_model_table", "label": "Combined model table", "file_type": "concept", "source_file": "src/_analysis_body.qmd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per event; narratives excluded because they describe outcomes; coverage-warning fla